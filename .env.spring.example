# Spring config loaded via env_file. Secrets (DB password, Keycloak/Google/R2 credentials)
# are intentionally not here -- supplied via Docker secrets instead (see secrets/*.example).

APP_AUTH_REDIRECT_URI_PUBLIC=https://localhost/
# Its host also decides which app a login returns to, so it must match ADMIN_HOST.
APP_AUTH_REDIRECT_URI_ADMIN=https://admin.localhost/
# Comma-separated emails granted ADMIN on first login.
APP_AUTH_ADMIN_EMAILS=

# Database (used for local, non-Docker runs; inside compose this is overridden by
# compose.yaml's own SPRING_DATASOURCE_URL/USERNAME interpolation from the root .env)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nerdiez
SPRING_DATASOURCE_USERNAME=root

# RSA
RSA_PUBLIC_KEY=classpath:certs/public-key.pem
RSA_PRIVATE_KEY=classpath:certs/private-key.pem

# Keycloak
KEYCLOAK_CLIENT_ID=nerdiez-client

# File upload settings
MULTIPART_MAX_FILE_SIZE=1MB
MULTIPART_MAX_REQUEST_SIZE=2MB
# Image uploads each website user may make per hour.
APP_UPLOAD_PUBLIC_MAX_PER_HOUR=20

# R2 (Cloudflare) object storage -- non-secret config only
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Cache config
## Post
APP_CACHE_POST_PUBLIC_BRIEF_TTL=5m
APP_CACHE_POST_PUBLIC_BRIEF_MAX_SIZE=10000
APP_CACHE_POST_ADMIN_BRIEF_TTL=30m
APP_CACHE_POST_ADMIN_BRIEF_MAX_SIZE=4000
APP_CACHE_POST_PUBLIC_DETAIL_TTL=30m
APP_CACHE_POST_PUBLIC_DETAIL_MAX_SIZE=1000
APP_CACHE_POST_ADMIN_DETAIL_TTL=1d
APP_CACHE_POST_ADMIN_DETAIL_MAX_SIZE=200
## Talk
APP_CACHE_TALK_PUBLIC_BRIEF_TTL=5m
APP_CACHE_TALK_PUBLIC_BRIEF_MAX_SIZE=10000
APP_CACHE_TALK_ADMIN_BRIEF_TTL=30m
APP_CACHE_TALK_ADMIN_BRIEF_MAX_SIZE=4000
APP_CACHE_TALK_PUBLIC_DETAIL_TTL=30m
APP_CACHE_TALK_PUBLIC_DETAIL_MAX_SIZE=1000
APP_CACHE_TALK_ADMIN_DETAIL_TTL=1d
APP_CACHE_TALK_ADMIN_DETAIL_MAX_SIZE=200
APP_CACHE_TALK_VOTE_TTL=3m
APP_CACHE_TALK_VOTE_MAX_SIZE=15000
## Category
APP_CACHE_CATEGORY_ADMIN_LIST_TTL=1d
APP_CACHE_CATEGORY_ADMIN_LIST_MAX_SIZE=200
APP_CACHE_CATEGORY_PUBLIC_LIST_TTL=1h
APP_CACHE_CATEGORY_PUBLIC_LIST_MAX_SIZE=400
## Tag
APP_CACHE_TAG_ADMIN_LIST_TTL=1d
APP_CACHE_TAG_ADMIN_LIST_MAX_SIZE=200
APP_CACHE_TAG_PUBLIC_LIST_TTL=1h
APP_CACHE_TAG_PUBLIC_LIST_MAX_SIZE=400
## Topic
APP_CACHE_TOPIC_ADMIN_LIST_TTL=1d
APP_CACHE_TOPIC_ADMIN_LIST_MAX_SIZE=200
APP_CACHE_TOPIC_PUBLIC_LIST_TTL=1h
APP_CACHE_TOPIC_PUBLIC_LIST_MAX_SIZE=400
## Vote
APP_CACHE_POST_VOTE_TTL=3m
APP_CACHE_POST_VOTE_MAX_SIZE=15000
