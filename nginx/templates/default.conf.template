# Rendered over the image's /etc/nginx/conf.d/default.conf at startup; ${VARS} come from compose.yaml.

# Upstream blocks (not variables) so host.docker.internal resolves from /etc/hosts in dev.
# They resolve once at startup: restart nginx after recreating a proxied container.
upstream nerdiez_website  { server ${WEBSITE_UPSTREAM}; }
upstream nerdiez_admin    { server ${ADMIN_UPSTREAM}; }
upstream nerdiez_spring   { server spring:8080; }
upstream nerdiez_keycloak { server keycloak:8080; }

# Lets `next dev` hot reload work through the proxy.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header Upgrade           $http_upgrade;
proxy_set_header Connection        $connection_upgrade;

gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;

# include /etc/nginx/snippets/cloudflare-real-ip.conf;

# Prod: Cloudflare Origin CA cert (SSL mode "Full (strict)"); dev: mkcert cert for localhost.
ssl_certificate     ${SSL_CERTIFICATE};
ssl_certificate_key ${SSL_CERTIFICATE_KEY};
ssl_protocols       TLSv1.2 TLSv1.3;
ssl_session_cache   shared:SSL:10m;
ssl_session_timeout 1d;

server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# Public website
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${PUBLIC_HOST};

    include /etc/nginx/snippets/spring-routes.conf;

    # Only what a browser needs to log in; the admin console stays on the localhost-bound port.
    location ~ ^/auth/(realms|resources|js)/ {
        proxy_pass http://nerdiez_keycloak;
        # Keycloak sends large auth headers and cookies.
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
    }
    location /auth/ {
        return 404;
    }

    location / {
        proxy_pass http://nerdiez_website;
    }
}

# Admin app
server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_HOST};

    include /etc/nginx/snippets/spring-routes.conf;

    location / {
        proxy_pass http://nerdiez_admin;
    }
}
