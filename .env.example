# Shared values used by Docker Compose's ${VAR} interpolation directly inside compose.yaml
# (the mysql service's own config, and part of Spring's JDBC URL). Compose auto-loads
# a file named exactly ".env" sitting next to compose.yaml for this purpose -- this is
# NOT passed into any container as-is; each service gets its own env_file for that.
MYSQL_DATABASE=nerdiez
MYSQL_USER=nerdiez_app

# Spring's browser-facing Keycloak provider URL (see application.properties) -- must match
# .env.keycloak's KC_HOSTNAME.
KEYCLOAK_PUBLIC_URL=https://localhost/auth

# nginx: hostnames it serves (prod: example.com / admin.example.com).
PUBLIC_HOST=localhost
ADMIN_HOST=admin.localhost
# nginx TLS files inside the container; defaults to mkcert's fullchain.pem/privkey.pem in nginx/certs.
# Prod: the Cloudflare Origin CA cert saved to nginx/certs.
# SSL_CERTIFICATE=/etc/nginx/certs/origin.pem
# SSL_CERTIFICATE_KEY=/etc/nginx/certs/origin.key
# nginx upstreams; defaults to the website/admin containers. Uncomment when running
# `npm run dev` on the host (website on 3000, admin on 3001).
# WEBSITE_UPSTREAM=host.docker.internal:3000
# ADMIN_UPSTREAM=host.docker.internal:3001
