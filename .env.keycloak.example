# Loaded into the keycloak container via env_file.
KC_BOOTSTRAP_ADMIN_USERNAME=admin

# Public URL Keycloak advertises to the browser -- the one value that differs per environment.
KC_HOSTNAME=https://localhost/auth
# Admin console isn't proxied by nginx; open it on the localhost-bound port (SSH tunnel in prod).
KC_HOSTNAME_ADMIN=http://localhost:8081/auth

# client-test's OAuth2 redirect URIs / CORS origins (comma-separated) -- differs per environment like KC_HOSTNAME; add prod URLs before deploying.
KC_CLIENT_REDIRECT_URIS=https://localhost/login/oauth2/code/keycloak,https://admin.localhost/login/oauth2/code/keycloak
KC_CLIENT_WEB_ORIGINS=https://localhost,https://admin.localhost

# Google/GitHub OAuth client IDs (aliases "google"/"github" in nerdiez-realm.json); secrets go in secrets/*_idp_client_secret.txt.
GOOGLE_IDP_CLIENT_ID=
GITHUB_IDP_CLIENT_ID=
